{
	"name": "@navopw/opencode-memory",
	"version": "0.4.4",
	"description": "Persistent semantic memory for OpenCode",
	"keywords": [
		"opencode",
		"opencode-plugin",
		"memory",
		"semantic-search",
		"embeddings",
		"local-first"
	],
	"type": "module",
	"packageManager": "bun@1.3.14",
	"os": [
		"darwin",
		"linux"
	],
	"license": "MIT",
	"author": "Stanislav Hetzel",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/navopw/opencode-memory.git"
	},
	"homepage": "https://github.com/navopw/opencode-memory#readme",
	"bugs": {
		"url": "https://github.com/navopw/opencode-memory/issues"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "bun run typecheck && bun test",
		"prepack": "bun run build",
		"bench": "bun run bench/run.ts",
		"smoke": "bun run bench/smoke.ts"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"@opencode-ai/plugin": "^1.18.9",
		"@opencode-ai/sdk": "^1.18.9",
		"proper-lockfile": "^4.1.2"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"@types/proper-lockfile": "^4.1.4",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"adm-zip": "0.6.0",
		"sharp": "0.35.3"
	},
	"trustedDependencies": [
		"onnxruntime-node"
	],
	"engines": {
		"bun": ">=1.3.0"
	}
}
