{
	"name": "opencode-memory",
	"version": "0.3.0",
	"description": "Persistent semantic memory for OpenCode",
	"keywords": [
		"opencode",
		"memory",
		"semantic-search",
		"local-first"
	],
	"type": "module",
	"private": true,
	"packageManager": "bun@1.3.14",
	"os": [
		"darwin",
		"linux"
	],
	"license": "MIT",
	"author": "Stanislav Hetzel",
	"files": [
		"src"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/navopw/opencode-memory.git"
	},
	"homepage": "https://github.com/navopw/opencode-memory#readme",
	"bugs": {
		"url": "https://github.com/navopw/opencode-memory/issues"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"check": "bun run typecheck && bun test",
		"bench": "bun run bench/run.ts",
		"smoke": "bun run bench/smoke.ts"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"@opencode-ai/plugin": "1.18.9",
		"@opencode-ai/sdk": "1.18.9",
		"proper-lockfile": "^4.1.2"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"@types/proper-lockfile": "^4.1.4",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"adm-zip": "0.6.0",
		"sharp": "0.35.3"
	},
	"trustedDependencies": [
		"onnxruntime-node"
	],
	"engines": {
		"bun": ">=1.3.0"
	}
}
